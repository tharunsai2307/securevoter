{
  "version": 2,
  "builds": [
    {
      "src": "public/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "public/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "public/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
